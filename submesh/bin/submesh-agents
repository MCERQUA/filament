#!/bin/bash
# submesh-agents — list all sub-mesh agents and their status

# In-container home of the submesh (webtop convention: /config). Override for other layouts.
SUBMESH_HOME="${SUBMESH_HOME:-/config}"

AGENTS_DIR=${SUBMESH_HOME}/submesh/agents
SLOTS_FILE=${SUBMESH_HOME}/submesh/slots
SESSION="submesh"

# Desk prefix — single source of truth in desk-prefix.sh. See that file for why the
# old hostname-substring chain put several desktops in one desktop's namespace.
if [ -r "${0%/*}/desk-prefix.sh" ]; then
    . "${0%/*}/desk-prefix.sh"
else
    # minimal fallback — keep in step with desk-prefix.sh resolution order
    case "${AGENT_URI:-}" in
        *-desktop@*) PREFIX="${AGENT_URI%%-desktop@*}-desk" ;;
        *)           PREFIX="desk" ;;
    esac
    [ -n "${SUBMESH_DESK_PREFIX:-}" ] && PREFIX="$SUBMESH_DESK_PREFIX"
fi

echo "SUB-MESH AGENTS"
echo "────────────────────────────────────────────────"
printf "%-20s %-6s %-22s %-10s\n" "NAME" "SLOT" "AGENT_URI" "STATUS"
echo "────────────────────────────────────────────────"

for dir in "$AGENTS_DIR"/*/; do
    [ -d "$dir" ] || continue
    name=$(basename "$dir")

    # get slot from slots file
    slot=$(grep ":${name}$" "$SLOTS_FILE" 2>/dev/null | cut -d: -f1)
    [ -z "$slot" ] && slot="-"
    agent_uri="${PREFIX}-${slot}@mesh"
    [ "$slot" = "-" ] && agent_uri="(unassigned)"

    # detect running: check if any grid pane or window has this agent
    running=false
    # -t= = EXACT session match; bare -t falls back to PREFIX matching, which reports a dead
    # $SESSION as alive whenever a longer-named session exists (e.g. `submesh` vs
    # `submesh-watch`). The ":grid" compound targets below stay on bare -t deliberately —
    # the `=` prefix is for a name, and its behaviour on a session:window spec is not
    # something to assume in a status reporter.
    if tmux has-session -t="$SESSION" 2>/dev/null; then
        # check all panes and windows
        # grid panes are tagged @submesh_agent=<name> by the launcher/new-agent
        if tmux list-panes -t "$SESSION:grid" -F '#{@submesh_agent}' 2>/dev/null | grep -qx -- "$name"; then
            running=true
        fi
        tmux list-windows -t "$SESSION" -F "#{window_name}" 2>/dev/null | grep -qx "$name" && running=true
    fi

    if $running; then
        status="● running"
    else
        status="○ stopped"
    fi

    printf "%-20s %-6s %-22s %-10s\n" "$name" "$slot" "$agent_uri" "$status"
done

echo ""
echo "Commands:"
echo "  new-agent <name> [type]      create & start an agent (assigns next free slot)"
echo "  join-submesh <name>          open an agent's view in Konsole"
echo "  stop-submesh <name>          stop one agent and free its slot"
echo "  stop-submesh all             kill entire session"
