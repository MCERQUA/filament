#!/bin/bash
# new-agent <name> [type] [context]
# Assigns a real desk slot (<PREFIX>-N@mesh, see desk-prefix.sh), generates
# a concrete CLAUDE.md with slot-specific inbox paths, and starts
# Claude Code with full mesh env set. Agents are autonomous from first keystroke.

# In-container home of the submesh (webtop convention: /config). Override for other layouts.
SUBMESH_HOME="${SUBMESH_HOME:-/config}"

NAME="$1"
TYPE="${2:-general}"
CONTEXT="$3"

if [ -z "$NAME" ]; then
    echo "Usage: new-agent <name> [type] [context]"
    echo "Types: manager, coder, researcher, reviewer, general"
    exit 1
fi

SESSION="submesh"
CLAUDE=${SUBMESH_HOME}/.local/bin/claude
TEMPLATES=${SUBMESH_HOME}/submesh-templates
AGENT_DIR=${SUBMESH_HOME}/submesh/agents/$NAME
SLOTS_FILE=${SUBMESH_HOME}/submesh/slots

# -- detect desk prefix --
#
# CROSS-DESK IDENTITY COLLISION (fixed upstream 2026-08). The old chain matched hostname
# SUBSTRINGS generic-last, and every desktop container's hostname shared a common base, so
# two desktops minted workers into ANOTHER desktop's slot namespace while writing into
# their own mounts — measured, not hypothetical: two desks both held
# `2:worker-1 3:worker-2 4:worker-3`, i.e. both claimed the same <prefix>-2/3/4@mesh.
# AGENT_URI is the authoritative identity and is set per desk, so it is preferred; the
# hostname is only a fallback, and is matched MOST-SPECIFIC-FIRST (see desk-prefix.sh).
# Sourced from desk-prefix.sh so all five tools share ONE definition. Keeping a
# corrected inline copy here would rebuild the exact condition that caused the bug:
# four divergent copies of one rule, of which fixing one looks like fixing the rule.
if [ -r "${0%/*}/desk-prefix.sh" ]; then
    . "${0%/*}/desk-prefix.sh"
else
    # minimal fallback — keep in step with desk-prefix.sh resolution order
    case "${AGENT_URI:-}" in
        *-desktop@*) PREFIX="${AGENT_URI%%-desktop@*}-desk" ;;
        *)           PREFIX="desk" ;;
    esac
    [ -n "${SUBMESH_DESK_PREFIX:-}" ] && PREFIX="$SUBMESH_DESK_PREFIX"
fi

# Refuse BEFORE touching the slots file or agent dir: checking after the slot was recorded left a
# phantom "N:name" entry behind on every failed start, and that slot then read as taken.
if ! tmux has-session -t="$SESSION" 2>/dev/null; then
    echo "Sub-mesh not running. Use start-submesh first."
    exit 1
fi

mkdir -p "$AGENT_DIR/workspace" "$AGENT_DIR/memory" ${SUBMESH_HOME}/submesh

# -- assign a numbered slot (1=manager, 2-4=workers) --
# slot file: each line is "N:agentname"
touch "$SLOTS_FILE"
# find which slots 2-4 are free
SLOT=""
for N in 2 3 4; do
    if ! grep -q "^${N}:" "$SLOTS_FILE" 2>/dev/null; then
        SLOT=$N
        break
    fi
done

if [ -z "$SLOT" ]; then
    echo "All desk slots (2-4) are occupied. Stop an agent first: stop-submesh <name>"
    submesh-agents
    exit 1
fi

AGENT_URI="${PREFIX}-${SLOT}@mesh"
MESH_INBOX="/agent-desk-${SLOT}/inbox"
# manager slot for workers to report to
MANAGER_URI="${PREFIX}-1@mesh"

# record slot assignment
echo "${SLOT}:${NAME}" >> "$SLOTS_FILE"

# -- build CLAUDE.md with concrete values --
if [ ! -f "$AGENT_DIR/CLAUDE.md" ]; then
    TEMPLATE="$TEMPLATES/${TYPE}.md"
    [ ! -f "$TEMPLATE" ] && TEMPLATE="$TEMPLATES/general.md"

    # Inject autonomous startup header with real slot values
    cat > "$AGENT_DIR/CLAUDE.md" << HEADER
# ${NAME} — ${TYPE} agent

## MESH IDENTITY (READ-ONLY)
- AGENT_URI: ${AGENT_URI}
- Desk slot: ${SLOT}
- Inbox: ${MESH_INBOX}
- Manager: ${MANAGER_URI}

## MANDATORY SESSION STARTUP — EXECUTE IMMEDIATELY, NO HUMAN NEEDED

You are a fully autonomous mesh agent. No human supervises you. On EVERY session start, before anything else, execute these steps automatically:

### Step 1 — Drain waiting messages
\`\`\`bash
mesh-recv
\`\`\`
Read and handle every message you find.

### Step 2 — Arm your inbox monitor
Use the Monitor tool (NOT bash — use the actual Monitor tool call):
- command: \`MESH_INBOX=${MESH_INBOX} mesh-watch-arm\`
- persistent: true
- timeout_ms: 3600000
- description: \`inbox: ${AGENT_URI}\`

This is what makes you autonomous. Without it you are deaf.

### Step 3 — When monitor fires \`[mesh new] inbox: <filename>\`
Run: \`mesh-recv --show <filename>\` → read → act → reply if needed.
Do this silently — no narration to humans.

### Step 4 — Announce ready to manager
\`\`\`bash
mesh-send ${MANAGER_URI} "${NAME} online — slot ${SLOT} — monitoring active"
\`\`\`

---

## ROLE

HEADER

    cat "$TEMPLATE" >> "$AGENT_DIR/CLAUDE.md"

    if [ -n "$CONTEXT" ]; then
        printf "\n## Current Task\n%s\n" "$CONTEXT" >> "$AGENT_DIR/CLAUDE.md"
    fi
fi

# -- write Claude Code hooks config into the agent's workspace --
mkdir -p "$AGENT_DIR/workspace/.claude"
cat > "$AGENT_DIR/workspace/.claude/settings.json" << SETTINGS
{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${SUBMESH_HOME}/mesh-tools/bin/render-guard.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "MESH_INBOX=${MESH_INBOX} AGENT_URI=${AGENT_URI} submesh-hook-check"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "MESH_INBOX=${MESH_INBOX} submesh-hook-stop"
          }
        ]
      }
    ]
  }
}
SETTINGS

CMD="export AGENT_URI=${AGENT_URI}; export MESH_INBOX=${MESH_INBOX}; export DESK_SLOT=${SLOT}; cd $AGENT_DIR/workspace; $CLAUDE --dangerously-skip-permissions"


# -- place in empty grid slot or overflow window --
FILLED=false
# A pane is FREE only if BOTH hold: it shows the "Slot N ready" marker AND its foreground
# process is a plain shell. The marker alone is not enough — it stays on screen after an
# agent starts in that pane, and typing a second launch command into a running agent's
# prompt is far worse than opening an overflow window. `clear` wipes the marker as the
# agent launches so the next new-agent cannot mistake this pane for a free one.
# A pane already tagged @submesh_agent (see stop-submesh) is never free.
for PANE in 1 2 3; do
    TAG=$(tmux display-message -p -t "$SESSION:grid.$PANE" '#{@submesh_agent}' 2>/dev/null)
    [ -n "$TAG" ] && continue
    FG=$(tmux display-message -p -t "$SESSION:grid.$PANE" '#{pane_current_command}' 2>/dev/null)
    case "$FG" in bash|sh|zsh|dash|fish) ;; *) continue ;; esac
    CONTENT=$(tmux capture-pane -t "$SESSION:grid.$PANE" -p 2>/dev/null | grep -c "Slot.*ready" || true)
    if [ "$CONTENT" -gt 0 ]; then
        # C-u clears any half-typed input. (This used to send a literal "q", which the shell
        # glued onto the launch line — "qexport AGENT_URI=..." — so the FIRST export failed
        # and the worker silently inherited the session-level AGENT_URI: the manager's.)
        tmux send-keys -t "$SESSION:grid.$PANE" C-u
        tmux set-option -p -t "$SESSION:grid.$PANE" @submesh_agent "$NAME"
        tmux send-keys -t "$SESSION:grid.$PANE" "clear; $CMD" Enter
        echo "Agent '${NAME}' (${AGENT_URI}) started in grid pane ${PANE} (slot ${SLOT})."
        FILLED=true
        break
    fi
done

if [ "$FILLED" = false ]; then
    tmux new-window -t "$SESSION" -n "$NAME" \
        -e "AGENT_URI=${AGENT_URI}" \
        -e "MESH_INBOX=${MESH_INBOX}" \
        -e "DESK_SLOT=${SLOT}" \
        -e "PATH=${SUBMESH_HOME}/.local/bin:/usr/local/bin:/usr/bin:/bin"
    tmux send-keys -t "$SESSION:$NAME" "$CMD" Enter
    echo "Agent '${NAME}' (${AGENT_URI}) started in overflow window."
    echo "Use: join-submesh $NAME"
fi
