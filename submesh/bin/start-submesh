#!/bin/bash
# start-submesh — creates the 4-pane 2x2 tmux session (no Konsole)
# To open the grid view, use: submesh-grid
# To open via the desktop icon, click Sub-Mesh (calls submesh-launch)

# In-container home of the submesh (webtop convention: /config). Override for other layouts.
SUBMESH_HOME="${SUBMESH_HOME:-/config}"

SESSION="submesh"
CLAUDE=${SUBMESH_HOME}/.local/bin/claude
WORKSPACE=${SUBMESH_HOME}/submesh/agents/manager/workspace
TEMPLATES=${SUBMESH_HOME}/submesh-templates

mkdir -p "$WORKSPACE" ${SUBMESH_HOME}/submesh/agents/manager/memory
[ ! -f ${SUBMESH_HOME}/submesh/agents/manager/CLAUDE.md ] && \
    cp "$TEMPLATES/manager.md" ${SUBMESH_HOME}/submesh/agents/manager/CLAUDE.md

if tmux has-session -t="$SESSION" 2>/dev/null; then
    echo "Sub-mesh already running. Use submesh-grid to view it."
    exit 0
fi

echo "Starting sub-mesh session..."

tmux new-session -d -s "$SESSION" -n grid \
    -e "AGENT_URI=manager@mesh" \
    -e "PATH=${SUBMESH_HOME}/.local/bin:/usr/local/bin:/usr/bin:/bin" \
    -x 220 -y 50

tmux send-keys -t "$SESSION:grid.0" \
    "export AGENT_URI=manager@mesh; cd $WORKSPACE; $CLAUDE --dangerously-skip-permissions" Enter

tmux split-window -h -t "$SESSION:grid.0"
tmux send-keys -t "$SESSION:grid.1" \
    "printf '\n  Slot 2 ready\n  Run: new-agent <name> [type]\n\n'" Enter

tmux split-window -v -t "$SESSION:grid.0"
tmux send-keys -t "$SESSION:grid.2" \
    "printf '\n  Slot 3 ready\n  Run: new-agent <name> [type]\n\n'" Enter

tmux split-window -v -t "$SESSION:grid.1"
tmux send-keys -t "$SESSION:grid.3" \
    "printf '\n  Slot 4 ready\n  Run: new-agent <name> [type]\n\n'" Enter

tmux select-layout -t "$SESSION:grid" tiled
tmux select-pane -t "$SESSION:grid.0"

echo "Sub-mesh started. Use submesh-grid to open the view."
