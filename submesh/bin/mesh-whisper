#!/bin/bash
# mesh-whisper <agent-name-or-slot> "message"
# Injects a message directly into a running agent's context via whisper file.
# Appears after their next tool call — no polling, no delay, no session disruption.
# The receiving agent sees it as a highlighted side-channel note mid-task.
#
# Usage:
#   mesh-whisper Research-Dept "hey check josh-desk-2 — they have a question for you"
#   mesh-whisper 2 "stop what you're doing, new priority: ..."
#   mesh-whisper josh-desk-3@mesh "don't use that API — it's rate limited"

TARGET="$1"
MESSAGE="$2"

if [ -z "$TARGET" ] || [ -z "$MESSAGE" ]; then
    echo "Usage: mesh-whisper <name|slot|agent-uri> \"message\""
    exit 1
fi

SLOTS_FILE=/config/submesh/slots

# resolve target to a slot number
SLOT=""
if [[ "$TARGET" =~ ^[0-9]+$ ]]; then
    SLOT="$TARGET"
elif [[ "$TARGET" =~ -([0-9]+)@mesh$ ]]; then
    SLOT="${BASH_REMATCH[1]}"
else
    SLOT=$(grep ":${TARGET}$" "$SLOTS_FILE" 2>/dev/null | cut -d: -f1)
fi

if [ -z "$SLOT" ]; then
    echo "Cannot find agent '$TARGET'. Known agents:"
    cat "$SLOTS_FILE" 2>/dev/null
    exit 1
fi

WHISPER_FILE="/agent-desk-${SLOT}/whisper.md"
AGENT_DIR=$(dirname "$WHISPER_FILE")

if [ ! -d "$AGENT_DIR" ]; then
    echo "Agent desk-${SLOT} directory not found. Is the mesh mounted?"
    exit 1
fi

# write whisper file — hook picks it up after next tool call
cat > "$WHISPER_FILE" << WHISPER
FROM: ${AGENT_URI:-operator}
${MESSAGE}
WHISPER

echo "Whispered to slot ${SLOT} (${WHISPER_FILE}). Agent will see it after their next tool call."
