[Unit]
Description=Filament blocker SLA sweep (escalates over-SLA blockers)
Documentation=https://github.com/MCERQUA/filament/blob/main/docs/OPERATOR-GUIDE.md
After=local-fs.target
Wants=local-fs.target

[Service]
Type=oneshot
User=filament
Group=filament
Environment=MESH_ROOT=/opt/filament-mesh
Environment=LOG_DIR=/var/log/filament
ExecStart=/bin/bash /opt/filament/repo/scripts/mesh-blocker-check.sh
StandardOutput=append:/var/log/filament/mesh-blocker-check.log
StandardError=append:/var/log/filament/mesh-blocker-check.log
Nice=10
