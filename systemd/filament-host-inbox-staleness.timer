[Unit]
Description=Run filament-host-inbox-staleness every 15 minutes
Documentation=https://github.com/MCERQUA/filament/blob/main/docs/OPERATOR-GUIDE.md

[Timer]
OnBootSec=5min
OnUnitActiveSec=15min
AccuracySec=30s
Persistent=true
Unit=filament-host-inbox-staleness.service

[Install]
WantedBy=timers.target
