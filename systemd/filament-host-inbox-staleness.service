[Unit]
Description=Filament host inbox staleness check (alerts when host stops processing inbox)
Documentation=https://github.com/MCERQUA/filament/blob/main/docs/OPERATOR-GUIDE.md
After=local-fs.target
Wants=local-fs.target

[Service]
Type=oneshot
User=filament
Group=filament
Environment=MESH_ROOT=/opt/filament-mesh
Environment=LOG_DIR=/var/log/filament
ExecStart=/bin/bash /opt/filament/repo/scripts/mesh-host-inbox-staleness-check.sh
StandardOutput=append:/var/log/filament/host-inbox-staleness.log
StandardError=append:/var/log/filament/host-inbox-staleness.log
Nice=10
