[Unit]
Description=Filament nightly reflection -- dispatch tasks to every agent
Documentation=https://github.com/MCERQUA/filament/blob/main/docs/REFLECTION-PROTOCOL.md
After=local-fs.target
Wants=local-fs.target

[Service]
Type=oneshot
User=filament
Group=filament
Environment=MESH_ROOT=/opt/filament-mesh
Environment=LOG_DIR=/var/log/filament
ExecStart=/bin/bash /opt/filament/repo/scripts/mesh-nightly-kickoff.sh
StandardOutput=append:/var/log/filament/nightly-kickoff.log
StandardError=append:/var/log/filament/nightly-kickoff.log
Nice=10
