[Unit]
Description=Run filament-nightly-synthesize daily at 04:00 UTC
Documentation=https://github.com/MCERQUA/filament/blob/main/docs/REFLECTION-PROTOCOL.md

[Timer]
OnCalendar=*-*-* 04:00:00 UTC
AccuracySec=1min
Persistent=true
Unit=filament-nightly-synthesize.service

[Install]
WantedBy=timers.target
