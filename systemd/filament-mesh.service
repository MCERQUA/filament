[Unit]
Description=Filament agent mesh inotify watchdog (host)
Documentation=file://__MESH_ROOT__/mesh/PROTOCOL.md
After=local-fs.target network.target
Wants=local-fs.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=__MESH_USER__
Group=__MESH_USER__
Environment=MESH_ROOT=__MESH_ROOT__
ExecStart=/bin/bash __SCRIPT_DIR__/mesh-inotify.sh
Restart=always
RestartSec=5
WorkingDirectory=__MESH_ROOT__
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
