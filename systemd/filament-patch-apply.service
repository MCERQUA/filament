[Unit]
Description=Filament KIND:patch auto-apply (scans agent inboxes, applies + pushes)
Documentation=https://github.com/MCERQUA/filament/blob/main/docs/OPERATOR-GUIDE.md
After=local-fs.target network.target
Wants=local-fs.target

[Service]
Type=oneshot
User=filament
Group=filament
Environment=MESH_ROOT=/opt/filament-mesh
Environment=FILAMENT_REPO=/opt/filament/repo
Environment=LOG_DIR=/var/log/filament
ExecStart=/bin/bash /opt/filament/repo/scripts/mesh-patch-apply.sh
StandardOutput=append:/var/log/filament/mesh-patch-apply.log
StandardError=append:/var/log/filament/mesh-patch-apply.log
Nice=10
