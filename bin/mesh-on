#!/usr/bin/env python3
"""mesh-on — session-start ritual for the agent mesh.

Sweeps stale .claim/ slots, re-reads /mesh/PROTOCOL.md version, prints the
bootstrap sequence summary (PROTOCOL §14), and advertises the watchdog log
for a caller to tail.

Does NOT itself tail the log — the Claude Code "Monitor" tool (or `tail -F`)
is the appropriate way to stream events. mesh-on reports the path and the
last ack-marker so the tailer can resume from there.

Stdlib-only.

Env:
    AGENT_URI    required
    MESH_ROOT    optional
    MESH_INBOX   optional — this agent's inbox dir, wins over every guess
    MESH_LOG     optional — watchdog log path
    MESH_SESSION_START_READ_CAP  optional — per-file char cap for SESSION-START-READS.txt (12000)

Usage:
    mesh-on                 # full bootstrap
    mesh-on --quiet         # skip printing message contents, only counts
    mesh-on --sweep-only    # only do the stale-claim sweep and exit
    mesh-on --check         # pre-flight diagnostic; exits nonzero with a specific
                            # error message if AGENT_URI, mesh root, PROTOCOL.md,
                            # REGISTRY, or inbox are missing/malformed
"""
from __future__ import annotations

import argparse
import datetime as _dt
import os
import re
import sys
import time
from pathlib import Path


def die(msg: str, code: int = 1) -> None:
    print(f"mesh-on: {msg}", file=sys.stderr)
    sys.exit(code)


def agent_name() -> str:
    uri = os.environ.get("AGENT_URI")
    if not uri:
        die("AGENT_URI env var required (e.g. AGENT_URI=host@mesh)")
    if not uri.endswith("@mesh"):
        die(f"AGENT_URI must end with @mesh, got: {uri}")
    # Strip EVERY @mesh, not just the last one. A single-suffix strip here, while another
    # normaliser in the same run used a global replace, made the two disagree on a doubled
    # URI ("x@mesh@mesh") — and anything written through verbatim (a filename AND the agent
    # field inside it) came out consistently wrong. Why it stayed invisible: a
    # filename-vs-field consistency check PASSES on that file. Consistency between two
    # derived values is satisfied by both failure modes, so it can never be the check that
    # catches either.
    name = uri.replace("@mesh", "")
    if not name:
        die(f"AGENT_URI has no agent name: {uri}")
    if uri.count("@mesh") > 1:
        print(f"mesh-on: WARNING - AGENT_URI has a doubled @mesh suffix ({uri}); "
              f"normalised to {name}@mesh for this run. The env is corrupt upstream and "
              f"mesh-send will FAIL CLOSED on it, so this lane's alarms cannot be heard. "
              f"Fix the invoker.",
              file=sys.stderr)
    return name


def resolve_my_desk_dir() -> Path:
    """Return this agent's own desk-root directory. See mesh-recv's identical
    helper for the full rationale; kept in sync by hand (stdlib-only tools,
    no shared import). Order: MESH_ROOT override -> desk-N mount matching
    AGENT_URI's own "-desk-<N>" suffix -> bare /agent-desk (only with no
    desk-N suffix) -> host path.
    """
    override = os.environ.get("MESH_ROOT")
    if override:
        return Path(override) / "agents" / agent_name()

    name = agent_name()
    m = re.match(r"^(.+)-desk-(\d+)$", name)
    if m:
        desk_n_dir = Path(f"/agent-desk-{m.group(2)}")
        if desk_n_dir.is_dir():
            return desk_n_dir
    elif Path("/agent-desk").is_dir():
        return Path("/agent-desk")

    if Path("/mnt/agent-mesh").is_dir():
        return Path("/mnt/agent-mesh/agents") / name

    die("cannot discover mesh root — set MESH_ROOT")


def _host_log_path() -> Path:
    """Watchdog log on a host. MESH_LOG wins; /var/log/jambot-mesh-inotify.log is a LEGACY
    name, used only when it already exists and the new name does not."""
    if os.environ.get("MESH_LOG"):
        return Path(os.environ["MESH_LOG"])
    new, legacy = Path("/var/log/filament-mesh.log"), Path("/var/log/jambot-mesh-inotify.log")
    return legacy if (legacy.exists() and not new.exists()) else new


def discover_roots() -> tuple[Path, Path, Path]:
    """Return (mesh_dir, my_dir, watchdog_log_path).

    On a container that bind-mounts BOTH /agent-desk (the parent agent's desk) and
    /agent-desk-<N> (this desk's own), the old check `Path("/agent-desk").is_dir()`
    matched FIRST unconditionally, so every "-desk-N" identity silently swept and read
    another agent's claims/inbox. my_dir now goes through resolve_my_desk_dir().
    """
    override = os.environ.get("MESH_ROOT")
    if override:
        root = Path(override)
        return root / "mesh", root / "agents" / agent_name(), _host_log_path()

    my_dir = resolve_my_desk_dir()
    if my_dir != Path("/mnt/agent-mesh/agents") / agent_name() and Path("/mesh").is_dir():
        return Path("/mesh"), my_dir, Path(os.environ.get("MESH_LOG") or "/config/workspace/mesh-events.log")

    if Path("/mnt/agent-mesh").is_dir():
        return Path("/mnt/agent-mesh/mesh"), my_dir, _host_log_path()

    die("cannot discover mesh root — set MESH_ROOT")


def sweep_stale_claims(root: Path) -> int:
    """Recursively sweep stale .claim dirs older than 60s. Returns count."""
    if not root.is_dir():
        return 0
    count = 0
    # Semaphore sentinels (SEMAPHORES/*.lock.claim) are legitimate for longer
    # operations — use 5 min cutoff for them, 60s for inbox/task claims.
    now = time.time()
    for entry in root.rglob("*.claim"):
        if entry.is_dir():
            try:
                under_sem = "SEMAPHORES" in entry.parts
                cutoff = now - 300 if under_sem else now - 60
                if entry.stat().st_mtime < cutoff:
                    entry.rmdir()
                    count += 1
            except OSError:
                pass
    return count


def sweep_stale_semaphore_locks(mesh_dir: Path) -> int:
    """Sweep SEMAPHORES/*.lock files whose ACQUIRED_AT exceeds MESH_SEMAPHORE_TTL.

    Returns count of locks removed.  Warns to stderr for each removal so the
    operator can identify which agent left a stale lock.
    """
    sem_dir = mesh_dir / "SEMAPHORES"
    if not sem_dir.is_dir():
        return 0
    ttl = int(os.environ.get("MESH_SEMAPHORE_TTL", "3600"))
    now = time.time()
    count = 0
    for lock_file in sem_dir.glob("*.lock"):
        if not lock_file.is_file():
            continue
        try:
            content = lock_file.read_text(encoding="utf-8")
            acquired_at = ""
            for line in content.splitlines():
                if line.startswith("ACQUIRED_AT:"):
                    acquired_at = line.split(":", 1)[1].strip()
                    break
            if not acquired_at:
                continue
            import datetime as _dt2
            try:
                acq_dt = _dt2.datetime.strptime(acquired_at, "%Y-%m-%dT%H:%M:%SZ").replace(
                    tzinfo=_dt2.timezone.utc
                )
                age = now - acq_dt.timestamp()
            except ValueError:
                continue
            if age > ttl:
                holder = ""
                for line in content.splitlines():
                    if line.startswith("HOLDER:"):
                        holder = line.split(":", 1)[1].strip()
                        break
                print(
                    f"mesh-on: stale semaphore lock removed: {lock_file.name} "
                    f"(holder: {holder or 'unknown'}, age: {int(age)}s > TTL {ttl}s)",
                    file=sys.stderr,
                )
                lock_file.unlink()
                sentinel = lock_file.with_suffix(".lock.claim")
                if sentinel.is_dir():
                    try:
                        sentinel.rmdir()
                    except OSError:
                        pass
                count += 1
        except OSError:
            pass
    return count


def read_protocol_version(mesh_dir: Path) -> tuple[str, float]:
    protocol = mesh_dir / "PROTOCOL.md"
    if not protocol.is_file():
        return ("(missing)", 0.0)
    mt = protocol.stat().st_mtime
    version = "?"
    try:
        with protocol.open("r", encoding="utf-8") as fh:
            for _ in range(15):
                line = next(fh, "")
                m = re.match(r"^version:\s*(\S+)", line)
                if m:
                    version = m.group(1)
                    break
    except OSError:
        pass
    return version, mt


def find_last_ack_marker(log_path: Path) -> str | None:
    if not log_path.is_file():
        return None
    try:
        with log_path.open("r", encoding="utf-8", errors="replace") as fh:
            lines = fh.readlines()
    except OSError:
        return None
    me = agent_name()
    for line in reversed(lines):
        if "# ACKED " in line and f"agent={me}" in line:
            return line.strip()
    return None


def tail(path: Path, n: int) -> list[str]:
    if not path.is_file():
        return []
    try:
        with path.open("r", encoding="utf-8", errors="replace") as fh:
            lines = fh.readlines()
    except OSError:
        return []
    return lines[-n:]


def list_inbox_summary(inbox: Path, quiet: bool) -> dict:
    stats = {"unread": 0, "read": 0, "files": []}
    if not inbox.is_dir():
        return stats
    for entry in inbox.iterdir():
        if entry.is_file() and entry.suffix == ".md":
            stats["unread"] += 1
            stats["files"].append(entry.name)
    read_dir = inbox / ".read"
    if read_dir.is_dir():
        for entry in read_dir.iterdir():
            if entry.is_file() and entry.suffix == ".md":
                stats["read"] += 1
    return stats


def run_checks(mesh_dir: Path, my_dir: Path) -> bool:
    """Pre-flight diagnostic. Prints one line per problem; returns True if all pass."""
    ok = True

    # 1. AGENT_URI format
    uri = os.environ.get("AGENT_URI", "")
    if not uri:
        print("mesh-on --check: FAIL AGENT_URI is not set. Export it: export AGENT_URI=my-agent@mesh", file=sys.stderr)
        ok = False
    elif not uri.endswith("@mesh"):
        print(f"mesh-on --check: FAIL AGENT_URI must end with @mesh, got: {uri}", file=sys.stderr)
        ok = False
    else:
        name = uri[: -len("@mesh")]
        if not re.fullmatch(r"[a-z0-9][a-z0-9\-]*", name):
            print(f"mesh-on --check: FAIL AGENT_URI agent name must be kebab-case, got: {name}", file=sys.stderr)
            ok = False

    # 2. mesh dir exists
    if not mesh_dir.is_dir():
        print(f"mesh-on --check: FAIL mesh dir not found: {mesh_dir}. Run scripts/mesh-init.sh or set MESH_ROOT.", file=sys.stderr)
        ok = False
    else:
        # 3. PROTOCOL.md present inside mesh root
        protocol = mesh_dir / "PROTOCOL.md"
        if not protocol.is_file():
            print(f"mesh-on --check: FAIL PROTOCOL.md missing at {protocol}. Re-run scripts/mesh-init.sh to restore it.", file=sys.stderr)
            ok = False

        # 4. REGISTRY has at least one entry
        registry_file = mesh_dir / "REGISTRY.md"
        reg_dir = mesh_dir / "REGISTRY"
        has_registry = (registry_file.is_file() and registry_file.stat().st_size > 0) or (
            reg_dir.is_dir() and any(True for _ in reg_dir.iterdir())
        )
        if not has_registry:
            print(
                "mesh-on --check: FAIL REGISTRY is empty — no agents registered. "
                "Run: sudo bash scripts/agent-add.sh <your-agent-name>",
                file=sys.stderr,
            )
            ok = False

    # 5. This agent's inbox exists
    inbox = my_dir / "inbox"
    if not inbox.is_dir():
        name = uri[: -len("@mesh")] if uri.endswith("@mesh") else uri
        print(
            f"mesh-on --check: FAIL inbox dir not found: {inbox}. "
            f"Run: sudo bash scripts/agent-add.sh {name}",
            file=sys.stderr,
        )
        ok = False

    if ok:
        print("mesh-on --check: all checks passed")
    return ok


def main() -> None:
    p = argparse.ArgumentParser()
    p.add_argument("--quiet", action="store_true")
    p.add_argument("--sweep-only", action="store_true")
    p.add_argument("--check", action="store_true",
                   help="pre-flight diagnostic: verify AGENT_URI, mesh root, PROTOCOL.md, REGISTRY, and inbox exist; exit nonzero on any failure")
    args = p.parse_args()

    if args.check:
        try:
            mesh_dir, my_dir, _ = discover_roots()
        except SystemExit:
            # discover_roots already printed the error
            sys.exit(1)
        sys.exit(0 if run_checks(mesh_dir, my_dir) else 1)

    mesh_dir, my_dir, log_path = discover_roots()

    # ---- 1. Sweep stale claims + stale semaphore locks ----
    swept = sweep_stale_claims(my_dir)
    swept += sweep_stale_claims(mesh_dir)
    swept += sweep_stale_semaphore_locks(mesh_dir)
    print(f"mesh-on: swept {swept} stale claim(s)")

    if args.sweep_only:
        return

    # ---- 2. Protocol version ----
    version, mt = read_protocol_version(mesh_dir)
    mt_iso = _dt.datetime.fromtimestamp(mt, tz=_dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ") if mt else "-"
    print(f"mesh-on: PROTOCOL.md version {version} (mtime {mt_iso})")

    # ---- 3. Inbox summary ----
    inbox = Path(os.environ["MESH_INBOX"]) if os.environ.get("MESH_INBOX") else my_dir / "inbox"
    stats = list_inbox_summary(inbox, args.quiet)
    print(f"mesh-on: {stats['unread']} unread / {stats['read']} acked in {inbox}")
    if not args.quiet and stats["files"]:
        for f in stats["files"][:10]:
            print(f"    - {f}")
        if len(stats["files"]) > 10:
            print(f"    ... and {len(stats['files']) - 10} more")

    # ---- 4. cc/<self>/ summary ----
    cc_dir = mesh_dir / "cc" / agent_name()
    # THREE VERDICTS, NOT TWO. `if cc_dir.is_dir(): count(...)` left cc_count at its init 0
    # when the directory did not exist, so A MISSING cc DIRECTORY AND AN EMPTY ONE PRINTED THE
    # SAME CONFIDENT ZERO. Measured: a banner read "0 cc'd in /mesh/cc/x@mesh" — a path that has
    # never existed (the URI was doubled) — while the real dir held unread cc traffic. A
    # detector whose "nothing here" is indistinguishable from "I could not look" is a defect.
    if not cc_dir.is_dir():
        print(f"mesh-on: cc dir MISSING — {cc_dir} does not exist (NOT the same as 0 cc'd; "
              f"check AGENT_URI is not doubled)")
    else:
        cc_count = sum(1 for e in cc_dir.iterdir() if e.is_file() and e.suffix == ".md")
        print(f"mesh-on: {cc_count} cc'd in {cc_dir}")

    # ---- 5. Registry peers ----
    registry_file = mesh_dir / "REGISTRY.md"
    peers = []
    if registry_file.is_file():
        try:
            for line in registry_file.read_text(encoding="utf-8").splitlines():
                m = re.match(r"^-\s+([a-z0-9][a-z0-9\-]*)\s*@\s*mesh", line)
                if m:
                    peers.append(m.group(1))
        except OSError:
            pass
    # fall back to scanning REGISTRY/
    if not peers:
        reg_dir = mesh_dir / "REGISTRY"
        if reg_dir.is_dir():
            for entry in reg_dir.iterdir():
                if entry.is_file() and entry.suffix == ".md":
                    peers.append(entry.stem)
    print(f"mesh-on: {len(peers)} peer(s) in REGISTRY: {', '.join(peers) if peers else '(none)'}")

    # ---- 6. STATE_CHECK latest 5 ----
    sc_dir = mesh_dir / "STATE_CHECK"
    sc_latest: list[str] = []
    if sc_dir.is_dir():
        sc_entries = sorted([e.name for e in sc_dir.iterdir() if e.is_file() and e.suffix == ".md"])
        sc_latest = sc_entries[-5:]
    print(f"mesh-on: STATE_CHECK latest 5: {', '.join(sc_latest) if sc_latest else '(none)'}")

    # ---- 7. Watchdog log + last ack-marker ----
    print(f"mesh-on: watchdog log: {log_path}")
    if log_path.is_file():
        recent = tail(log_path, 5)
        if recent and not args.quiet:
            print("mesh-on: last 5 log lines:")
            for line in recent:
                print(f"    {line.rstrip()}")
    last_ack = find_last_ack_marker(log_path)
    if last_ack:
        print(f"mesh-on: last ack-marker: {last_ack}")
    else:
        print("mesh-on: no prior ack-marker found for this agent — full replay recommended")

    # ---- 7b. SESSION-START READS ----
    # A file that says "read at session start, every session" is a convention until something
    # opens it. Measured: a manager's OPEN-HOLDS.md said exactly that; nothing carried the
    # instruction; 4 of 18 holds went materially stale. This is the construction: a lane lists
    # the files its session must open in <its desk>/SESSION-START-READS.txt (one path per line,
    # as the lane sees it, # comments allowed) and mesh-on prints each one here — the agent
    # cannot skip a file that is already in front of it. Capped per file so a runaway register
    # cannot flood the boot; a MISSING file is said out loud, never silently skipped.
    _ssr = my_dir / "SESSION-START-READS.txt"
    if _ssr.is_file():
        _cap = int(os.environ.get("MESH_SESSION_START_READ_CAP", "12000"))
        _lines = [l.strip() for l in _ssr.read_text(encoding="utf-8", errors="replace").splitlines()]
        _paths = [l for l in _lines if l and not l.startswith("#")]
        print(f"mesh-on: SESSION-START READS — {len(_paths)} file(s) declared in {_ssr}")
        for _p in _paths:
            _fp = Path(os.path.expandvars(os.path.expanduser(_p)))
            if not _fp.is_file():
                print(f"mesh-on: === SESSION-START READ MISSING: {_p} (declared, not found from this lane) ===")
                continue
            try:
                _txt = _fp.read_text(encoding="utf-8", errors="replace")
            except Exception as _e:  # noqa: BLE001
                print(f"mesh-on: === SESSION-START READ UNREADABLE: {_p} ({_e}) ===")
                continue
            _mt = _dt.datetime.fromtimestamp(_fp.stat().st_mtime, tz=_dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
            print(f"mesh-on: === SESSION-START READ: {_p} ({len(_txt)} chars, mtime {_mt}) ===")
            print(_txt[:_cap].rstrip())
            if len(_txt) > _cap:
                print(f"mesh-on: === (truncated at {_cap} chars — open {_p} for the rest) ===")
            print(f"mesh-on: === END {_p} ===")

    # ---- 8. Open blockers ----
    blockers_dir = my_dir / "blockers"
    open_blockers = 0
    if blockers_dir.is_dir():
        for bf in blockers_dir.glob("*.md"):
            try:
                head = bf.read_text(encoding="utf-8", errors="replace")[:500]
                if re.search(r"^STATUS:\s*OPEN\s*$", head, re.MULTILINE):
                    open_blockers += 1
            except OSError:
                pass
    if open_blockers:
        print(f"mesh-on: *** {open_blockers} OPEN blocker(s) — run: mesh-blocker list ***")
    else:
        print("mesh-on: 0 open blockers")

    print(f"mesh comms armed — watching {log_path} — peers: {peers}")


if __name__ == "__main__":
    main()
